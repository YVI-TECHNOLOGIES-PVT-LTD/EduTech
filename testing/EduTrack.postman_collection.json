                  "var uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
                  "var id = jsonData.document_id || jsonData.id || (jsonData.data && (jsonData.data.document_id || jsonData.data.id));",
                  "if (id && uuidRegex.test(id)) { pm.environment.set('documentId', id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
