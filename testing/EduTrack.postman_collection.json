                  "pm.test('Response is an array', function () { pm.expect(Array.isArray(jsonData)).to.be.true; });",
                  "if (Array.isArray(jsonData) && jsonData.length > 0) {",
                  "    var candidate = jsonData[0].id;",
                  "    var uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
                  "    if (candidate && uuidRegex.test(candidate)) {",
                  "        pm.environment.set('schoolId', candidate);",
                  "    }",
