# Optional overrides for docker compose.
# A clean checkout does not need this file. Defaults are local Postgres on
# 127.0.0.1, placeholder Supabase values, and placeholder JWT values.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build
#
# Names are EDUTRACK_* so a developer .env (used by Compose only for ${} interpolation)
# cannot leak a real DATABASE_URL or Supabase key into the containers.
# If you change the Postgres user, password, or database, change the two URLs to match.

EDUTRACK_POSTGRES_USER=edutrack
EDUTRACK_POSTGRES_PASSWORD=edutrack
EDUTRACK_POSTGRES_DB=edutrack
EDUTRACK_POSTGRES_PORT=5432

EDUTRACK_DATABASE_URL=postgresql://edutrack:edutrack@postgres:5432/edutrack?schema=public
EDUTRACK_DIRECT_URL=postgresql://edutrack:edutrack@postgres:5432/edutrack?schema=public

EDUTRACK_SUPABASE_URL=https://placeholder.supabase.co
EDUTRACK_SUPABASE_KEY=placeholder-service-role-key
EDUTRACK_FRONTEND_URL=http://127.0.0.1:8080
EDUTRACK_JWT_SECRET=local-dev-jwt-secret-change-me
EDUTRACK_JWT_REFRESH_SECRET=local-dev-jwt-refresh-secret-change-me
EDUTRACK_SYSTEM_MODE=UAT
EDUTRACK_RUN_DB_PUSH=true

EDUTRACK_BACKEND_PORT=3000
EDUTRACK_WEB_PORT=8080
EDUTRACK_VITE_API_URL=http://127.0.0.1:3000/api
EDUTRACK_VITE_SUPABASE_URL=https://placeholder.supabase.co
EDUTRACK_VITE_SUPABASE_ANON_KEY=placeholder-anon-key
