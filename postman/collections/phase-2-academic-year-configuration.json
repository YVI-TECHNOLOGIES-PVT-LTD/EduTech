      "key": "baseUrl",
      "value": "http://localhost:4000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "tenantBToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "academicYearId",
      "value": "",
      "type": "string"
    },
    {
      "key": "gradeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "academicYearGradeId",
      "value": "",
      "type": "string"
    },
