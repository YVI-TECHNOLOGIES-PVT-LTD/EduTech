    {
      "name": "1. Academic Year Management",
      "item": [
        {
          "name": "Create Academic Year",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.academic_year_id) {",
                  "    pm.collectionVariables.set('academicYearId', res.data.academic_year_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"academic_year_name\": \"2026-2027\",\n  \"start_date\": \"2026-06-01T00:00:00.000Z\",\n  \"end_date\": \"2027-04-30T00:00:00.000Z\",\n  \"status\": \"planning\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/academic/years",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "academic", "years"]
            }
          }
        },
        {
          "name": "List Academic Years",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/academic/years?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "academic", "years"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Academic Year By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/academic/years/{{academicYearId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "academic", "years", "{{academicYearId}}"]
            }
          }
        },
        {
          "name": "Update Academic Year",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"open\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/academic/years/{{academicYearId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "academic", "years", "{{academicYearId}}"]
            }
          }
        },
        {
          "name": "Set Current Academic Year",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/academic/years/{{academicYearId}}/set-current",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "academic", "years", "{{academicYearId}}", "set-current"]
            }
          }
        },
        {
          "name": "Get Current Academic Year",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/academic/years/current",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "academic", "years", "current"]
            }
          }
        },
        {
          "name": "Get Academic Year Tree Structure",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/academic/years/{{academicYearId}}/structure",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "academic", "years", "{{academicYearId}}", "structure"]
            }
          }
        },
        {
          "name": "Archive Academic Year",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/academic/years/{{academicYearId}}/archive",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "academic", "years", "{{academicYearId}}", "archive"]
            }
          }
        },
        {
          "name": "Tenant Isolation: Cross-Tenant Year Access (404 expected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cross-tenant returns 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tenantBToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/academic/years/{{academicYearId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "academic", "years", "{{academicYearId}}"]
            }
          }
        }
      ]
    },
