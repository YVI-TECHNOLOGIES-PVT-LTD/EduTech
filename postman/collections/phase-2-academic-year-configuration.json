        },
        {
          "name": "Prevent Duplicate Grade Code (409 expected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Conflict 409 returned for duplicate code', function () {",
                  "    pm.response.to.have.status(409);",
