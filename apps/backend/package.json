{
    "name": "@edutrack/api",
    "version": "0.1.0",
    "description": "Backend API for School Management System",
    "main": "dist/server.js",
    "scripts": {
        "start": "node dist/server.js",
        "dev": "nodemon",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --ext .ts",
        "test": "jest",
        "check-port": "netstat -ano | findstr :3000",
        "inspect-db": "node scratch_test.js",
        "migrate-114": "node scripts/run-migration-114.js",
        "migrate-116": "node scripts/run-migration-116.js",
        "migrate-117": "node scripts/run-migration-117.js",
        "migrate-118": "node scripts/run-migration-118.js",
        "migrate-119": "node scripts/run-migration-119.js",
        "migrate-120": "node scripts/run-migration-120.js",
        "migrate": "npx ts-node scripts/migration-runner.ts",
        "migrate:status": "npx ts-node scripts/migration-runner.ts --status",
        "migrate:dry-run": "npx ts-node scripts/migration-runner.ts --dry-run",
        "migrate:decommission": "npx ts-node scripts/migration-runner.ts --from=131 --to=140",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:pull": "prisma db pull"
    },
    "dependencies": {
        "@edutrack/types": "workspace:*",
        "@edutrack/validation": "workspace:*",
        "@prisma/client": "^5.22.0",
        "@supabase/supabase-js": "^2.39.0",
        "archiver": "^7.0.1",
        "axios": "^1.13.4",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "csv-parse": "^6.1.0",
        "dotenv": "^16.6.1",
        "express": "^4.22.1",
        "express-rate-limit": "^8.2.1",
        "helmet": "^7.1.0",
        "json2csv": "^6.0.0-alpha.2",
        "morgan": "^1.10.0",
        "multer": "^2.0.2",
        "pdf-parse": "^2.4.5",
        "puppeteer": "^24.37.2",
        "xlsx": "^0.18.5",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/archiver": "^7.0.0",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/express-rate-limit": "^6.0.2",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^20.19.31",
        "@types/pg": "^8.11.5",
        "@types/readdir-glob": "^1.1.5",
        "nodemon": "^3.1.11",
        "pg": "^8.11.3",
        "prisma": "^5.22.0",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.2"
    }
}
