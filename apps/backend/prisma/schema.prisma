generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model academic_year_grades {
  academic_year_grade_id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academic_year_id                             String                     @db.Uuid
  grade_id                                     String                     @db.Uuid
  intake_capacity                              Int?
  is_active                                    Boolean                    @default(true)
  created_at                                   DateTime                   @default(now()) @db.Timestamptz(6)
  created_by                                   String?                    @db.Uuid
  updated_at                                   DateTime                   @default(now()) @db.Timestamptz(6)
  updated_by                                   String?                    @db.Uuid
  academic_years                               academic_years             @relation(fields: [academic_year_id], references: [academic_year_id], onDelete: Cascade, onUpdate: NoAction)
  users_academic_year_grades_created_byTousers users?                     @relation("academic_year_grades_created_byTousers", fields: [created_by], references: [user_id], onUpdate: NoAction)
  grades                                       grades                     @relation(fields: [grade_id], references: [grade_id], onDelete: Cascade, onUpdate: NoAction)
  users_academic_year_grades_updated_byTousers users?                     @relation("academic_year_grades_updated_byTousers", fields: [updated_by], references: [user_id], onUpdate: NoAction)
  assessment_configurations                    assessment_configurations?
  leads                                        leads[]
  sections                                     sections[]
  student_enrollments                          student_enrollments[]

  @@unique([academic_year_id, grade_id])
  @@index([academic_year_id], map: "ix_academic_year_grades_academic_year")
  @@index([grade_id], map: "ix_academic_year_grades_grade")
  @@schema("public")
}

