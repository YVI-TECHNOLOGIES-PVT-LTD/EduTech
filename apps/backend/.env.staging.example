# EduTrack Backend — Isolated Staging Configuration Template (Placeholders Only)
# Never commit real secrets or point to the production Supabase project.

PORT=3000
NODE_ENV=staging
SYSTEM_MODE=UAT
FRONTEND_URL=https://<STAGING_FRONTEND_ORIGIN>

STAGING_PROJECT_REF=<STAGING_PROJECT_REF>

# Staging Supabase instance (distinct from production)
SUPABASE_URL=https://<STAGING_PROJECT_REF>.supabase.co
SUPABASE_KEY=<STAGING_SUPABASE_KEY>
SUPABASE_SERVICE_ROLE_KEY=<STAGING_SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_ADMISSION_DOCUMENTS_BUCKET=admission-documents-staging

# Transaction-mode PgBouncer URI (port 6543, sslmode=require)
DATABASE_URL=<STAGING_POOLER_URI>
STAGING_POOLER_URI=<STAGING_POOLER_URI>

# Direct PostgreSQL session URI (port 5432, sslmode=require)
DIRECT_URL=<STAGING_DIRECT_URI>
STAGING_DIRECT_URI=<STAGING_DIRECT_URI>

# NativeJwt staging secrets (distinct from production)
JWT_SECRET=<STAGING_NATIVE_JWT_SECRET>
JWT_REFRESH_SECRET=<STAGING_NATIVE_JWT_REFRESH_SECRET>

# Initial database write safety locks
DATABASE_WRITE_ENABLED=false
ALLOW_LIVE_MUTATIONS=false

