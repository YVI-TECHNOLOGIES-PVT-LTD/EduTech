# -----------------------------------------------------------------------------
# EduTrack ERP Backend — Environment Configuration Template (Render Production)
# -----------------------------------------------------------------------------

# [RUNTIME & NETWORK]
PORT=3000
NODE_ENV=production
SYSTEM_MODE=PRODUCTION

# [FRONTEND URL FOR CORS & AUTH REDIRECTS]
FRONTEND_URL=https://edutrackcom.netlify.app

# [DATABASE CONFIGURATION — PRISMA / POSTGRESQL]
# Required for Prisma ORM runtime database operations
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require"
# Optional direct connection URL for migrations/direct querying
DIRECT_URL="postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require"

# [AUTHENTICATION & JWT SECRETS]
# Secure 256-bit+ random secret keys for signing native access & refresh tokens
JWT_SECRET="edutrack-production-jwt-access-secret-replace-with-secure-random"
JWT_REFRESH_SECRET="edutrack-production-jwt-refresh-secret-replace-with-secure-random"

# [SUPABASE SERVICE CONTEXT & STORAGE INTEGRATION]
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<your-supabase-service-role-secret-key>"
# Or SUPABASE_KEY
SUPABASE_ADMISSION_DOCUMENTS_BUCKET="admission-documents"

# [OPTIONAL — EXTERNAL COMMUNICATIONS & SERVICES]
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# GEMINI_API_KEY=""
