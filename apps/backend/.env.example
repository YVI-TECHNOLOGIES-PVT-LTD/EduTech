PORT=3000
NODE_ENV=production

# -------------------------------------------------------
# SUPABASE — Core Platform
# -------------------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SECRET>
SUPABASE_ANON_KEY=<YOUR_SECRET>
SUPABASE_KEY=<YOUR_SECRET>

# -------------------------------------------------------
# PRISMA ORM — Database URLs
# DATABASE_URL  : transaction-mode pooler (pgBouncer) — used by Prisma Client at runtime
# DIRECT_URL    : session-mode pooler                 — used by Prisma Migrate / db pull / db push
# -------------------------------------------------------
DATABASE_URL="postgresql://<user>:<password>@<supabase-pooler-host>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://<user>:<password>@<supabase-pooler-host>:5432/postgres"

# -------------------------------------------------------
# AUTH — JSON Web Tokens
# Generate with: openssl rand -hex 32
# Do NOT reuse the values below or the source-code defaults in production.
# -------------------------------------------------------
JWT_SECRET=<YOUR_SECRET>
JWT_REFRESH_SECRET=<YOUR_SECRET>

# -------------------------------------------------------
# CORS — Deployed frontend origin (Netlify production URL)
# -------------------------------------------------------
FRONTEND_URL=https://appsms.netlify.app

# -------------------------------------------------------
# APP MODE — UAT disables production safety lockdowns and
# force-enables all feature flags; PRODUCTION enforces both.
# -------------------------------------------------------
SYSTEM_MODE=PRODUCTION
