# =============================================================================
# EduTrack Backend API — Environment Variable Template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# See docs/configuration.md for the full variable reference.
# =============================================================================

PORT=3000
NODE_ENV=development

# -------------------------------------------------------
# SUPABASE — Core Platform (Required)
# -------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# -------------------------------------------------------
# PRISMA ORM — Database URLs (Required)
# DATABASE_URL : transaction-mode pooler (pgBouncer) — used by Prisma Client at runtime
# DIRECT_URL   : session-mode pooler                 — used by Prisma Migrate / db pull / db push
# -------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

SYSTEM_MODE=UAT
FRONTEND_URL=http://localhost:5173

# -------------------------------------------------------
# CACHING PLATFORM (ADR-009) — Optional, disabled by default
#
# CACHE_PROVIDER selects the adapter used by CacheService:
#   memory (default) — in-process TTL cache, no external dependency
#   redis            — RedisCacheAdapter, requires REDIS_URL below
#
# Leaving these unset preserves current behaviour exactly (in-memory cache).
# -------------------------------------------------------
CACHE_PROVIDER=memory
# REDIS_URL=redis://localhost:6379
# REDIS_CONNECT_TIMEOUT_MS=5000
# REDIS_MAX_RETRIES_PER_REQUEST=3
