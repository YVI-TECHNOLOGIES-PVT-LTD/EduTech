# -----------------------------------------------------------------------------
# EduTrack ERP Web App — Environment Variables Template
# -----------------------------------------------------------------------------
# All client-side variables must be prefixed with VITE_ to be exposed to the browser.
# DO NOT store sensitive server credentials (database URLs, JWT secrets) in this file.

# [REQUIRED] Backend API Base URL (including /api prefix)
VITE_API_URL=https://appsms-076a.onrender.com/api

# [OPTIONAL] Portal UI Configuration
VITE_APP_TITLE="EduTrack ERP Admin Portal"
VITE_SESSION_TIMEOUT_MINS=60
VITE_DEFAULT_TENANT_ID=""
VITE_ENABLE_MOCK_API="false"

# [OPTIONAL] Supabase Client (Public Anon Key only - browser safe)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# [OPTIONAL] Translation Service Configuration
VITE_TRANSLATION_API_URL=""
VITE_TRANSLATION_API_KEY=""
