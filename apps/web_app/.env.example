# -------------------------------------------------------
# EduTrack Web — Local Development Environment Template
# Copy this file to `.env` and fill in real values locally.
# Real production values belong ONLY in Netlify's Environment
# Variables dashboard — never commit a filled-in `.env` here.
# -------------------------------------------------------

# Supabase project this frontend talks to directly (auth/session).
# The anon key is designed to be public (protected by Row Level
# Security), but the project URL/key pair should still match
# whichever Supabase project the backend's SUPABASE_URL points to —
# see docs/deployment/DATABASE-CONFIGURATION-MISMATCH.md.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>

# Backend API base URL. Local dev defaults to http://127.0.0.1:3000/api
# if unset; production (Netlify) is already set in netlify.toml.
VITE_API_URL=http://127.0.0.1:3000/api
