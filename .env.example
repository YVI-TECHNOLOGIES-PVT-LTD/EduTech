# =======================================================
# EduTrack Enterprise ERP — Environment Variable Template
# Copy this file to .env.docker or .env.development and populate actual values
# =======================================================

# -------------------------------------------------------
# Node & Runtime Execution Settings
# -------------------------------------------------------
PORT=3000
NODE_ENV=development
SYSTEM_MODE=UAT

# -------------------------------------------------------
# Supabase Platform Services (Cloud PostgreSQL & Auth)
# [SENSITIVE] Keep Service Role Keys secure and out of git repositories.
# -------------------------------------------------------
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# -------------------------------------------------------
# Database ORM Connection Strings (Supabase Cloud PostgreSQL)
# [SENSITIVE] Contains database user credentials.
# DATABASE_URL  : Transaction pooler (pgBouncer) used at runtime
# DIRECT_URL    : Session connection used for Prisma migrations
# -------------------------------------------------------
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.your-project.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.your-project.supabase.co:5432/postgres"

# -------------------------------------------------------
# Client CORS & Public Frontend Environment Variables
# -------------------------------------------------------
FRONTEND_URL=http://localhost:5173
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_API_URL=http://localhost:3000/api
